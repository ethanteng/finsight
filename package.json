{
  "name": "finsight",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:ci": "jest --config jest.integration.ci.config.js",
    "test:security": "jest --config jest.security.config.js",
    "test:like-cicd": "./scripts/test-like-cicd.sh",
    "test:security:like-cicd:script": "./scripts/test-security-like-cicd.sh",
    "test:cicd:security": "./scripts/test-cicd-security.sh",
    "test:real-security": "jest --config jest.real-security.config.js",
    "test:security:real": "npm run test:real-security",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage:unit": "jest --coverage --testPathPattern=unit",
    "test:coverage:integration": "jest --config jest.integration.config.js --coverage",
    "test:coverage:all": "npm run test:coverage:unit && npm run test:coverage:integration",
    "test:enhanced-market-context": "jest --testPathPattern=enhanced-market-context|scheduled-updates --verbose",
    "test:enhanced-market-context:watch": "jest --testPathPattern=enhanced-market-context|scheduled-updates --watch",
    "test:lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "type-check": "tsc --noEmit --project tsconfig.build.json",
    "build": "npm install && npx prisma generate && npm run clean:backend && tsc --project tsconfig.build.json --outDir dist",
    "build:backend": "npx prisma generate && npm run clean:backend && NODE_OPTIONS='--max-old-space-size=4096' tsc --project tsconfig.build.json --outDir ./dist && echo 'TypeScript compilation completed' && ls -la dist/",
    "build:prisma": "prisma generate",
    "postinstall": "patch-package",
    "build:render": "NODE_OPTIONS='--max-old-space-size=2048' npm install --include=dev && prisma generate && npm run build:backend && echo 'Build completed' && ls -la dist/ && echo 'Verifying index.js exists:' && ls -la dist/index.js",
    "build:production": "npm install && npx prisma generate && npm run clean:backend && tsc --project tsconfig.build.json --outDir dist",
    "build:deploy": "./deploy-build.sh",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:status": "npx prisma migrate status",
    "start": "node dist/index.js || node ./dist/index.js || (echo 'Build failed, attempting to build now...' && npm run build:backend && node dist/index.js) || (echo 'Current directory:' && pwd && echo 'Directory contents:' && ls -la && echo 'Dist contents:' && ls -la dist/ && exit 1)",
    "dev:backend": "ts-node src/index.ts",
    "dev:backend:sandbox": "PLAID_MODE=sandbox ts-node src/index.ts",
    "dev:backend:production": "PLAID_MODE=production ts-node src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:sandbox": "concurrently \"npm run dev:backend:sandbox\" \"npm run dev:frontend\"",
    "dev:production": "concurrently \"npm run dev:backend:production\" \"npm run dev:frontend\"",
    "dev:reset": "./scripts/dev-reset.sh",
    "test:token-scope": "node scripts/test-token-scope.js",
    "test:production-investments": "node scripts/test-production-investments.js",
    "check:access-tokens": "node scripts/check-access-tokens.js",
    "migrate:profiles-to-encryption": "node scripts/migrate-profiles-to-encryption.js",
    "test:gpt-smoke": "node scripts/test-gpt-smoke.js",
    "send:test-email": "node scripts/send-test-email.js",
    "clean:backend": "rm -rf ./dist",
    "clean": "rm -rf node_modules dist build out .next .cache .parcel-cache coverage .nyc_output .eslintcache *.tsbuildinfo .babelcache storybook-static",
    "reset": "npm run clean && npm install",
    "rebuild": "npm run clean && npm install && npm run build",
    "clean:all": "npm run clean && rm -rf prisma/migrations_backup",
    "fix:duplicate-accounts": "npx ts-node scripts/fix-duplicate-accounts.ts",
    "build:market-dataset": "npx ts-node scripts/build-market-dataset.ts",
    "eval:llm": "npx ts-node src/evals/ask-linc-eval.ts",
    "test:security:all": "npm run test:security && npm run test:real-security"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^9.2.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/generative-ai": "^0.21.0",
    "@heycatch/sdk": "^0.7.0",
    "@polygon.io/client-js": "^8.0.0",
    "@prisma/client": "^6.12.0",
    "@prisma/instrumentation": "^6.12.0",
    "@sentry/node": "^10.70.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/stripe": "^8.0.416",
    "@types/uuid": "^10.0.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "openai": "^5.10.2",
    "patch-package": "^8.0.0",
    "plaid": "^37.0.0",
    "prisma": "^6.12.0",
    "react-plaid-link": "^4.0.1",
    "resend": "^4.8.0",
    "snaptrade-typescript-sdk": "^9.0.145",
    "stripe": "^18.4.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "axios": "^1.13.5",
    "js-yaml": "^4.1.1",
    "body-parser": "^2.2.1",
    "jws": "^3.2.3",
    "qs": "^6.14.2",
    "minimatch": "^10.2.1"
  }
}
